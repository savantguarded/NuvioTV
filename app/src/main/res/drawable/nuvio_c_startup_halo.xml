<?xml version="1.0" encoding="utf-8"?>
<!-- [fork] Nuvio C round 26b startup_breathe: a soft halo behind the logo that slowly swells and brightens.
     An AnimatedVectorDrawable in an ImageView, so Android's render thread animates it while the app is busy;
     a slow change of size and light hides a late frame far better than something moving across the screen.
     The circle is stretched into a wide oval by the outer group, so the gradient fades out evenly. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="420dp"
            android:height="220dp"
            android:viewportWidth="420"
            android:viewportHeight="220">
            <group
                android:pivotX="210"
                android:pivotY="110"
                android:scaleX="1.9">
                <group
                    android:name="breathe"
                    android:pivotX="210"
                    android:pivotY="110"
                    android:scaleX="0.9"
                    android:scaleY="0.9">
                    <path
                        android:name="halo"
                        android:fillAlpha="0.45"
                        android:pathData="M210,10 a100,100 0 1,1 0,200 a100,100 0 1,1 0,-200 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="radial"
                                android:centerX="210"
                                android:centerY="110"
                                android:gradientRadius="100">
                                <item android:offset="0" android:color="#33FFFFFF" />
                                <item android:offset="0.5" android:color="#12FFFFFF" />
                                <item android:offset="1" android:color="#00FFFFFF" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="breathe">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.9"
                    android:valueTo="1.06"
                    android:valueType="floatType"
                    android:duration="2600"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.9"
                    android:valueTo="1.06"
                    android:valueType="floatType"
                    android:duration="2600"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.45"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="2600"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
